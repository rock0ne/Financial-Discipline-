# GEMINI_API_KEY: Required for Gemini AI Advisor calls (configured via Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional BYOK server-side keys for additional AI providers (never stored in browser UI):
# ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
